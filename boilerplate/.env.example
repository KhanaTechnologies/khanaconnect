# Copy to .env.local (git-ignored). Never point a dev machine at production data you don't own.
# API base including /api/v1. Local API: http://localhost:3000/api/v1 · mock: http://localhost:4010/api/v1
VITE_API_BASE_URL=http://localhost:4010/api/v1
# The client's storefront token (dashboard → Settings → Website token). It is public by design.
VITE_STOREFRONT_TOKEN=
